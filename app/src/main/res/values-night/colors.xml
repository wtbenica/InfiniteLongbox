<!--
  Dark mode: the same ROLES as values/colors.xml, filled from other ramp shades. Dark surfaces are
  the dark neutrals, and the accent steps up a shade so it still reads against them.
-->
<resources>

    <color name="surface">@color/neutral_900</color>
    <color name="surface_raised">@color/neutral_800</color>
    <color name="surface_sunken">@color/neutral_950</color>
    <color name="outline">@color/neutral_700</color>
    <color name="card_border">@color/neutral_1000</color>
    <color name="card_tab">@color/neutral_800</color>

    <color name="text_primary">@color/neutral_50</color>
    <color name="text_secondary">@color/neutral_400</color>

    <color name="accent">@color/accent_400</color>
    <color name="accent_soft">@color/accent_800</color>
    <color name="accent_strong">@color/accent_200</color>
    <color name="on_accent">@color/neutral_950</color>

    <color name="scrim_surface">#49232220</color>

    <!-- Dark: the wash darkens covers instead of fading them to white -->
    <color name="cover_wash">#99181716</color>
    <color name="card_shadow">#99A9A59E</color>
    <color name="masthead_chip">#CC333230</color>
    <color name="masthead_ink">@color/neutral_50</color>

    <color name="placeholder_sky">@color/neutral_800</color>
    <color name="placeholder_hill_far">@color/accent_800</color>
    <color name="placeholder_hill_near">@color/accent_700</color>

</resources>
