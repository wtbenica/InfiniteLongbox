<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$Behavior"
        app:layout_insetEdge="top">

        <FrameLayout
            android:id="@+id/details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|enterAlways|exitUntilCollapsed" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/results_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorUiBackground"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Same area as the list (under the app bar), so its handle spans the visible list -->
    <dev.benica.infinite_longbox.views.FastScrollHandle
        android:id="@+id/fast_scroll_handle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- A-Z along the edge, in place of the handle on lists sorted by name -->
    <dev.benica.infinite_longbox.views.LetterStrip
        android:id="@+id/letter_strip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- The letter or date the fast-scroll handle is at, shown while the handle is -->
    <TextView
        android:id="@+id/fast_scroll_bubble"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:minWidth="64dp"
        android:paddingHorizontal="16dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="40dp"
        android:background="@drawable/fast_scroll_bubble"
        android:fontFamily="@font/permanent_marker"
        android:gravity="center"
        android:textColor="@color/on_accent"
        android:textSize="32sp"
        android:visibility="gone"
        tools:text="A"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
