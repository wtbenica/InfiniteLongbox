<!--
  The theme. Colors are never chosen here: every color item points at a ROLE from values/colors.xml
  (surface, text_primary, accent, ...). Light and dark are the same theme: only the role colors differ.
-->
<resources>
    <style name="Theme.InfiniteLongbox" parent="BaseTheme">
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <!-- The Light parent hard-codes a light dialog surface; follow the role colors instead -->
    <style name="AppAlertDialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorBackgroundFloating">@color/surface_raised</item>
        <item name="android:colorBackground">@color/surface_raised</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <!-- The list in setItems dialogs (Replace / Remove cover) -->
        <item name="textColorAlertDialogListItem">@color/text_primary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="android:windowBackground">@color/surface_raised</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/accent</item>
    </style>

    <style name="BaseTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimaryVariant">@color/accent_strong</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent_strong</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_strong</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="fontBlock">@string/font_condensed</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="textColorTitleBar">@color/accent_strong</item>
        <item name="textColorBody">@color/text_primary</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardMaxElevation">@dimen/card_elevation</item>
        <item name="cardCornerRadius">@dimen/radius_default</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="colorUi">@color/surface_raised</item>
        <item name="colorUiBackground">@color/surface</item>
        <item name="colorUiInterface">@color/accent_strong</item>
        <item name="mainActivityProgressBarBgColor">@color/surface_sunken</item>
        <item name="mainActivityProgressBarIndeterminateTint">@color/accent</item>
        <item name="imageLabelBackgroundColor">@color/accent_soft</item>
        <item name="imageLabelTint">@color/accent_strong</item>
        <item name="searchBarTextColorHint">@color/text_secondary</item>
        <item name="searchBarTextColor">@color/text_primary</item>
        <item name="searchBarBackground">@android:color/transparent</item>
        <item name="filterSectionBackgroundColor">@color/surface_sunken</item>
        <item name="filterChipGroupBackground">@android:color/transparent</item>
        <item name="chipActiveBgColor">@color/accent_soft</item>
        <item name="chipInactiveBgColor">@color/surface_raised</item>
        <item name="chipActiveStrokeColor">@color/accent</item>
        <item name="chipInactiveStrokeColor">@color/outline</item>
        <item name="chipTextColor">@color/text_primary</item>
        <item name="chipIconSize">20dp</item>
        <item name="listItemBackgroundBase">@drawable/bg_placeholder</item>
        <item name="listItemSimpleTitleTextBackgroundColor">@color/scrim_surface</item>
        <item name="listItemSimpleMetaBoxBgColor">@color/accent_soft</item>
        <item name="listItemSimpleMetaBoxBgStrokeColor">@color/accent</item>
        <item name="listItemSimpleMetaBoxCornerRadius">48dp</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="chipStyle">@style/myNewChip</item>
        <item name="materialButtonStyle">@style/myButtonStyle</item>
        <item name="android:buttonBarButtonStyle">@style/IssueDetailButtonBarButton</item>
        <item name="android:buttonBarStyle">@style/IssueDetailButtonBar</item>
        <item name="cardViewStyle">@style/myCardView</item>
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorBackgroundFloating">@color/surface_raised</item>
        <item name="android:colorBackgroundFloating">@color/surface_raised</item>
        <item name="colorButtonNormal">@color/surface_sunken</item>
        <item name="alertDialogTheme">@style/AppAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/AppAlertDialog</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">?attr/textColorBody</item>
        <item name="android:textColor">?attr/textColorBody</item>
    </style>
</resources>
