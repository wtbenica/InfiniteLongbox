<resources>

    <style name="SplashTheme" parent="Theme.InfiniteLongbox">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="myAppBarLayout" parent="Widget.Design.AppBarLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/colorUi</item>
    </style>

    <style name="myCardView" parent="CardView">
        <item name="cardElevation">?attr/cardElevation</item>
        <item name="cardMaxElevation">?attr/cardMaxElevation</item>
        <item name="cardCornerRadius">?attr/cardCornerRadius</item>
        <item name="cardUseCompatPadding">?attr/cardUseCompatPadding</item>
    </style>

</resources>